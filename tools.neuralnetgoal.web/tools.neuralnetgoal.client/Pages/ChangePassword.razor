@page "/change-password"
@attribute [Authorize]
@inject ApiClient Api
@inject ApiAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Change password - NeuralNetGoal</PageTitle>

<div class="nng-card mx-auto" style="max-width: 480px;">
    <h4 class="nng-accent mb-3">Change password</h4>
    @if (Auth.Current?.MustChangePassword == true)
    {
        <div class="alert alert-info py-2">You must choose a new password before you can continue.</div>
    }
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="mb-3">
            <label class="form-label">Current password</label>
            <TelerikTextBox @bind-Value="_current" Password="true" AutoComplete="current-password" Width="100%" />
        </div>
        <div class="mb-3">
            <label class="form-label">New password <small class="text-secondary">(at least 10 characters, letters and digits)</small></label>
            <TelerikTextBox @bind-Value="_new" Password="true" AutoComplete="new-password" Width="100%" />
        </div>
        <div class="mb-3">
            <label class="form-label">Repeat the new password</label>
            <TelerikTextBox @bind-Value="_repeat" Password="true" AutoComplete="new-password" Width="100%" />
        </div>
        @if (_error is not null) { <div class="alert alert-danger py-2">@_error</div> }
        @if (_done) { <div class="alert alert-success py-2">Password changed.</div> }
        <TelerikButton ButtonType="@ButtonType.Submit" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Enabled="@(!_busy)">Save</TelerikButton>
    </form>
</div>

@code {
    private string _current = "", _new = "", _repeat = "";
    private string? _error;
    private bool _busy, _done;

    private async Task SaveAsync()
    {
        _error = null; _done = false;
        if (_new != _repeat) { _error = "The two new passwords are not the same."; return; }
        _busy = true;
        var r = await Api.ChangePasswordAsync(_current, _new);
        _busy = false;
        if (!r.Ok) { _error = r.Error; return; }

        Auth.SetUser(r.Value);
        _current = _new = _repeat = "";
        _done = true;
        Nav.NavigateTo("", replace: true);
    }
}
