<Project Sdk="Microsoft.NET.Sdk">

  <!-- TEMPORARY desktop client. It calls the parser (in-process or through the Web API on the VPS),
       stores results in the existing SQL Server database, builds the league tables with the existing stored
       procedure, and exports the final Excel file. It will be replaced by the Blazor web app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>neuralnetgoal.console</AssemblyName>
    <RootNamespace>NeuralNetGoal.ConsoleApp</RootNamespace>
    <UserSecretsId>neuralnetgoal-console-6f1c1b64-5f0b-4a53-9a7b-2f4b2a6a9c11</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="GemBox.Spreadsheet" Version="47.0.1044" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\parser\neuralnetgoal.parser\neuralnetgoal.parser.csproj" />
    <ProjectReference Include="..\parser\neuralnetgoal.parser.client\neuralnetgoal.parser.client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="templates\Training_data.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
