<Project>
  <!-- Shared settings for every project under /parser. Change the framework in ONE place. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NeuralNetGoal.Parser</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
