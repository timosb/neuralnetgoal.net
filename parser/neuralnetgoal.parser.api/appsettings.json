{
  "Logging": {
    "Directory": "logs"
  },
  "AllowedHosts": "*",

  "Parser": {
    "ApiKey": ""
  },

  "Jobs": {
    "MaxConcurrentJobs": 2,
    "RetentionHours": 6,
    "EventBufferSize": 5000
  },

  "Betexplorer": {
    "BaseUrl": "https://www.betexplorer.com",
    "CatalogPath": "/football/",
    "MaxConcurrentRequests": 4,
    "DelayBetweenRequestsMs": 400,
    "MaxRetries": 3,
    "RequestTimeoutSeconds": 30,
    "DetailPageAttempts": 3,
    "ProxyUrl": null,
    "Cookie": null,
    "DumpDirectory": null
  }
}
