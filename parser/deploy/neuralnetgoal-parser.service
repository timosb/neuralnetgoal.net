# /etc/systemd/system/neuralnetgoal-parser.service
# The parser API runs as an unprivileged user, listens on localhost only, and nginx is the only thing facing the internet.
[Unit]
Description=neuralnetgoal parser API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/neuralnetgoal-parser
ExecStart=/usr/bin/dotnet /opt/neuralnetgoal-parser/neuralnetgoal.parser.api.dll --urls http://127.0.0.1:5234
Restart=always
RestartSec=5
User=nngparser
Group=nngparser
SyslogIdentifier=neuralnetgoal-parser
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# systemd creates /var/log/neuralnetgoal-parser owned by the service user; the API writes its rolling log files there.
LogsDirectory=neuralnetgoal-parser
Environment=Logging__Directory=/var/log/neuralnetgoal-parser
# Secrets live HERE (not in git, not in this file):  Parser__ApiKey=<long random string>
#                                                    Betexplorer__ProxyUrl=<only if the site blocks the VPS>
EnvironmentFile=/etc/neuralnetgoal-parser.env
# lets the unprivileged service user listen on port 443 (needed only when Kestrel serves HTTPS itself, see README)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# light hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
